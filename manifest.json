{

  "description": "Generates a poster for printing from a sonderpreis-baumarkt article.",
  "manifest_version": 2,
  "name": "SPB Poster Generator",
  "version": "1.0",
  "homepage_url": "https://github.com/FritzK-Hub/SPBPosterGenerator",
  "icons": {
    "48": "icons/border-48.png"
  },

  "content_scripts": [
    {
      "matches": ["*://*.sonderpreis-baumarkt.de/*"],
      "js": ["main.js"],
      "css": ["css/override.css", "css/fonts.css"]
    }
  ],

  "web_accessible_resources": [
    "images/sale_background.png", 
    "images/regular_background.png", 
    "fonts/Sans-Bold.otf",
    "fonts/Sans-BoldCond.otf",
    "fonts/Sans-Cond.otf",
    "fonts/Sans-Light.otf",
    "fonts/Sans-Regular.otf",
    "fonts/Sans-SemiBold.otf"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "{22c4e184-734c-4df5-acf1-7b394e0d56ec}"
    }
  }
}
